PORT=8787
CORS_ORIGINS=
JWT_SECRET=
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Si usas Neon o cualquier Postgres externo, completa DATABASE_URL con sslmode=require.
# Ejemplo: postgresql://USER:PASSWORD@ep-xxxx.sa-east-1.aws.neon.tech/DB?sslmode=require
# Cuando DATABASE_URL esta presente, PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE quedan como fallback.
DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=municipal
PGPASSWORD=municipal
PGDATABASE=municipal_db
PGSSLMODE=disable
RAG_SYNC_ON_BOOT=false
RAG_SPIDER_ENABLED=false
RAG_SPIDER_INTERNAL_URL=
RAG_ARTIFACT_DIR=server/data/rag-artifacts
RAG_PUBLIC_INDEX_ENABLED=false
GTFS_FORCE_RESEED=false
AUTH_ENABLE_DEMO_USERS=false
AUTH_SEED_ADMIN_PASSWORD=
AUTH_SEED_DEV_PASSWORD=
AUTH_SEED_RECOLECTOR_PASSWORD=
AUTH_SEED_DIFUSOR_PASSWORD=
COLLECTION_ADMIN_USERNAME=
COLLECTION_ADMIN_PASSWORD=
BLOB_READ_WRITE_TOKEN=
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
